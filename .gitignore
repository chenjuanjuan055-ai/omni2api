upstreams/grok-register/config.json.bak*
upstreams/grok-register/*mailboxes*.txt
upstreams/grok-register/mail_credentials.txt
upstreams/grok-register/candidates.txt
upstreams/grok-register/probe_swapped.txt
upstreams/grok-register/proxy_pool.txt
upstreams/grok-register/proxy_pool_state.json
upstreams/grok-register/screenshots/
*.pyc
data/
logs/
.DS_Store
web/node_modules/
web/.next/
web/package-lock.json
web/.npmrc
web_dist/

# 本地密钥/临时产物
totp_results.txt
_tmp/
utils/output/
config.json

# GPT 注册机（turb-gpt-free-register）的运行时产物
