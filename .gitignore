upstreams/*/data/
upstreams/*/run.*.log
upstreams/*/frontend/dist/
upstreams/*/.gocache/
# 含管理员口令与加密密钥的本地配置（用 *.example.yaml 做模板）
upstreams/*/config.yaml
# grok-register 的运行时产物与凭据
upstreams/grok-register/accounts_*.txt
upstreams/grok-register/cpa_auths/
upstreams/grok-register/cpa_xai/
